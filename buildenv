# bump: sear-version /SEAR_VERSION="(.*)"/ https://github.com/Mainframe-Renewal-Project/sear.git|semver:*
SEAR_VERSION="0.7.1"

###
### Build control file for the sear port
###

###
### Required Environment Variables
###
export ZOPEN_PROJECT_NAME="sear"
export ZOPEN_BUILD_LINE="STABLE"
export ZOPEN_STABLE_URL="https://github.com/Mainframe-Renewal-Project/sear/archive/refs/tags/v${SEAR_VERSION}.tar.gz"
export ZOPEN_STABLE_DEPS="cmake make openssl"
export ZOPEN_DEV_URL="https://github.com/Mainframe-Renewal-Project/sear.git"
export ZOPEN_DEV_DEPS="cmake make openssl"
export ZOPEN_CATEGORIES="security"
export ZOPEN_RUNTIME_DEPS=""
# export ZOPEN_SYSTEM_PREREQ="zos25" # optional system pre-req (default=zos25)

sear_default_python=0
if [ "${ZOPEN_IS_BOT:-0}" = 1 ] && [ -z "${PAX_RPM_OPTIONS:-}" ]; then
  sear_default_python=1
fi

if [ "${SEAR_BUILD_PYTHON:-${sear_default_python}}" = 1 ]; then
  export ZOPEN_PROJECT_NAME="pysear"
  export ZOPEN_BUILD_SYSTEM="Python"
  export ZOPEN_COMP="${ZOPEN_COMP:-openxl}"
  export ZOPEN_PYTHON_VERSIONS="${ZOPEN_PYTHON_VERSIONS:-3.14}"
  export ZOPEN_PYTHON_WHEEL_RETAG="false"
  export ZOPEN_PATCH_DIR="python-patches"
  export ZOPEN_STABLE_DEPS="openssl"
  export ZOPEN_DEV_DEPS="openssl"
  export ZOPEN_RUNTIME_DEPS="openssl"

  zopen_post_buildenv() {
    if [ "${ZOPEN_BUILD_LINE}" = STABLE ]; then
      export ZOPEN_NAME="pysear-$(zopen_get_version)"
    else
      export ZOPEN_NAME="pysear-DEV"
    fi
  }

  zopen_pre_build() {
    export OPENSSL_ROOT="${OPENSSL_HOME}"
    export ZOSLIB_ROOT="${ZOSLIB_HOME}"
    if [ "${ZOPEN_IS_BOT:-0}" = 1 ]; then
      export LDFLAGS="${LDFLAGS:+${LDFLAGS} }-Wl,-b,map -Wl,-b,xref"
    fi
    if [ "${ZOPEN_BUILD_LINE}" = STABLE ]; then
      export SETUPTOOLS_SCM_PRETEND_VERSION_FOR_PYSEAR="$(zopen_get_version)"
    fi
  }

  zopen_python_test() {
    if python -I -c 'import sear._C; from sear import sear'; then
      echo 'SEAR_IMPORT_OK'
    else
      echo 'SEAR_IMPORT_FAILED'
      return 1
    fi
  }

  zopen_check_results() {
    awk -v versions="${ZOPEN_PYTHON_VERSIONS}" '
      /Running tests with Python/ { runs++ }
      /^SEAR_IMPORT_OK$/ { passed++ }
      /^SEAR_IMPORT_FAILED$/ { failed++ }
      END {
        expected = split(versions, interpreters)
        if (runs > expected) expected = runs
        total = passed + failed
        if (expected > total) {
          failed += expected - total
          total = expected
        }
        printf "actualFailures:%d\ntotalTests:%d\nexpectedFailures:0\nexpectedTotalTests:%d\n", failed, total, expected
      }
    ' "$1/$2_check.log"
  }
else

###
### Build settings (Port type: BUILD, Build system: CMake)
###
### Settings for CMake build system
export ZOPEN_CONFIGURE="cmake"
export ZOPEN_CONFIGURE_OPTS="-B ../build -DCMAKE_INSTALL_PREFIX=\${ZOPEN_INSTALL_DIR} -DOPENSSL_ROOT_DIR=\$OPENSSL_HOME -DZOSLIB=\$ZOSLIB_HOME/lib/libzoslib.a -DCMAKE_ASM_COMPILER=\"/bin/as\" -DCMAKE_ASM_FLAGS=\"-mGOFF\""
export ZOPEN_MAKE="cmake"
export ZOPEN_MAKE_OPTS="--build ../build --target sear"
export ZOPEN_MAKE_MINIMAL=Y
export ZOPEN_INSTALL="cmake"
export ZOPEN_INSTALL_OPTS="--install ../build"
# ZOPEN_CHECK is often 'ctest' or a custom function.
#export ZOPEN_CHECK="ctest"
#export ZOPEN_CHECK_OPTS="--test-dir ../build --output-on-failure"


###
### Required user-supplied functions
###

zopen_check_results() {
  dir="$1"
  pfx="$2"
  chk="$1/$2_check.log"
  # Add logic to extract the test results here:
  echo "actualFailures:0"
  echo "totalTests:1"
  echo "expectedFailures:0"
  echo "expectedTotalTests:1"
}
fi

zopen_get_version() {
  printf '%s\n' "${SEAR_VERSION}"
}


